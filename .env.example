# Obligatorio: acepta el EULA de Minecraft
EULA=TRUE

# Nombre del mundo y versión
VERSION=LATEST
TYPE=PAPER
LEVEL=world
MOTD=Servidor 24/7 con Docker
DIFFICULTY=normal
MODE=survival

# Rendimiento
MEMORY=4G
MAX_PLAYERS=20
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6
ENABLE_AUTOPAUSE=false

# Consola remota (RCON)
ENABLE_RCON=true
RCON_PASSWORD=cambia_esta_password
RCON_PORT=25575

# Whitelist y operadores
ENABLE_WHITELIST=false
WHITELIST=""
OPS=""

# Backups
ENABLE_BACKUPS=true
BACKUP_INTERVAL=12h
TZ=America/Mexico_City

# Mods y plugins (opcional)
PLUGINS=""
MODS=""
CF_SERVER_MOD=""
